{% liquid
  assign duration_ms = section.settings.autoplay_seconds | times: 1000
  assign slide_count = section.blocks.size
%}

<section
  id="tentwenty-hero-{{ section.id }}"
  class="tentwenty-hero-section"
  aria-label="{{ section.settings.accessibility_label | escape }}"
  style="--tentwenty-hero-duration: {{ duration_ms }}ms;"
>
  <tentwenty-hero
    class="tentwenty-hero"
    data-duration="{{ duration_ms }}"
    {% if section.settings.autoplay and slide_count > 1 %}
      data-autoplay
    {% endif %}
  >
    <div class="tentwenty-hero__slides" aria-roledescription="carousel">
      {% for block in section.blocks %}
        {% liquid
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          assign thumbnail_image = block.settings.thumbnail_image | default: desktop_image
          assign image_loading = 'lazy'
          assign image_priority = 'auto'
          if forloop.first
            assign image_loading = 'eager'
            assign image_priority = 'high'
          endif
        %}
        <article
          class="tentwenty-hero__slide{% if forloop.first %} is-active{% endif %}"
          id="tentwenty-hero-slide-{{ section.id }}-{{ forloop.index0 }}"
          data-hero-slide
          data-index="{{ forloop.index0 }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {% unless forloop.first %}inert{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="tentwenty-hero__media">
            {% if desktop_image != blank %}
              <picture>
                {% if mobile_image != blank %}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ mobile_image | image_url: width: 900 }}"
                    width="{{ mobile_image.width }}"
                    height="{{ mobile_image.height }}"
                  >
                {% endif %}
                {{
                  desktop_image
                  | image_url: width: 2880
                  | image_tag:
                    class: 'tentwenty-hero__image',
                    widths: '750, 1100, 1500, 2000, 2400, 2880',
                    sizes: '100vw',
                    loading: image_loading,
                    fetchpriority: image_priority,
                    alt: desktop_image.alt
                }}
              </picture>
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'tentwenty-hero__image tentwenty-hero__image--placeholder' }}
            {% endif %}
          </div>
          <div class="tentwenty-hero__scrim" aria-hidden="true"></div>

          <div class="tentwenty-hero__content">
            {% if block.settings.eyebrow != blank %}
              <p class="tentwenty-hero__eyebrow" data-hero-animate>{{ block.settings.eyebrow | escape }}</p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2 class="tentwenty-hero__heading" data-hero-animate>{{ block.settings.heading | escape | newline_to_br }}</h2>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="tentwenty-hero__description" data-hero-animate>{{ block.settings.description }}</div>
            {% endif %}
            {% if block.settings.cta_label != blank and block.settings.cta_url != blank %}
              <a class="tentwenty-hero__cta" data-hero-animate href="{{ block.settings.cta_url }}">
                <span>{{ block.settings.cta_label | escape }}</span>
                <span class="svg-wrapper" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if slide_count > 1 %}
      <div class="tentwenty-hero__controls" aria-label="{{ 'accessibility.slideshow' | t }}">
        <button class="tentwenty-hero__control" type="button" data-hero-previous aria-label="Previous slide">
          <span class="svg-wrapper tentwenty-hero__previous-icon" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </button>
        <div class="tentwenty-hero__thumbnails" role="tablist" aria-label="Select slide">
          {% for block in section.blocks %}
            {% assign thumbnail_image = block.settings.thumbnail_image | default: block.settings.desktop_image %}
            <button
              class="tentwenty-hero__thumbnail{% if forloop.first %} is-selected{% endif %}"
              type="button"
              role="tab"
              data-hero-thumbnail
              data-index="{{ forloop.index0 }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="tentwenty-hero-slide-{{ section.id }}-{{ forloop.index0 }}"
              aria-label="Slide {{ forloop.index }} of {{ slide_count }}"
            >
              {% if thumbnail_image != blank %}
                {{ thumbnail_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '44px', alt: thumbnail_image.alt }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'tentwenty-hero__thumbnail-image' }}
              {% endif %}
              <span class="tentwenty-hero__thumbnail-progress" aria-hidden="true"></span>
            </button>
          {% endfor %}
        </div>
        <button class="tentwenty-hero__control" type="button" data-hero-next aria-label="Next slide">
          <span class="svg-wrapper" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </button>
        <p class="tentwenty-hero__counter" aria-live="polite"><span data-hero-current>01</span><span aria-hidden="true"></span><span>{{ slide_count | prepend: '0' | slice: -2, 2 }}</span></p>
      </div>
    {% endif %}
  </tentwenty-hero>
</section>

<script src="{{ 'tentwenty-hero.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .tentwenty-hero {
    display: block;
    position: relative;
    min-height: clamp(36rem, calc(100svh - var(--header-height)), 52rem);
    overflow: hidden;
    background: #1d2615;
    color: #fff;
  }

  .tentwenty-hero__slides,
  .tentwenty-hero__slide,
  .tentwenty-hero__media,
  .tentwenty-hero__scrim {
    position: absolute;
    inset: 0;
  }

  .tentwenty-hero__slide {
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tentwenty-hero__slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }

  .tentwenty-hero__media {
    overflow: hidden;
  }

  .tentwenty-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.06);
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tentwenty-hero__slide.is-active .tentwenty-hero__image {
    transform: scale(1);
  }

  .tentwenty-hero__image--placeholder {
    fill: #415530;
  }

  .tentwenty-hero__scrim {
    background: linear-gradient(90deg, rgb(0 0 0 / 35%) 0%, rgb(0 0 0 / 8%) 65%, rgb(0 0 0 / 15%) 100%);
  }

  .tentwenty-hero__content {
    position: absolute;
    z-index: 2;
    left: max(var(--page-margin), 9vw);
    bottom: clamp(8.5rem, 19vh, 12rem);
    max-width: min(42rem, calc(100% - var(--page-margin) * 2));
    text-wrap: balance;
  }

  .tentwenty-hero__eyebrow,
  .tentwenty-hero__heading,
  .tentwenty-hero__description,
  .tentwenty-hero__cta {
    margin: 0;
    color: inherit;
    text-shadow: 0 1px 12px rgb(0 0 0 / 30%);
  }

  .tentwenty-hero__eyebrow {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .tentwenty-hero__heading {
    max-width: 18ch;
    font-family: var(--font-heading--family);
    font-size: clamp(2.75rem, 4vw, 4.25rem);
    font-weight: var(--font-heading--weight);
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .tentwenty-hero__description {
    max-width: 34rem;
    margin-top: 1.25rem;
    font-size: 1rem;
    line-height: 1.45;
  }

  .tentwenty-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: inherit;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .tentwenty-hero__cta .svg-wrapper,
  .tentwenty-hero__cta svg {
    width: 1rem;
    height: 1rem;
  }

  .tentwenty-hero__controls {
    position: absolute;
    z-index: 3;
    bottom: clamp(1.5rem, 4vw, 3rem);
    left: max(var(--page-margin), 9vw);
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .tentwenty-hero__control,
  .tentwenty-hero__thumbnail {
    appearance: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    background: transparent;
  }

  .tentwenty-hero__control {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    padding: 0;
  }

  .tentwenty-hero__control .svg-wrapper,
  .tentwenty-hero__control svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .tentwenty-hero__previous-icon {
    transform: rotate(180deg);
  }

  .tentwenty-hero__thumbnails {
    display: flex;
    gap: 0.5rem;
  }

  .tentwenty-hero__thumbnail {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.1875rem;
  }

  .tentwenty-hero__thumbnail img,
  .tentwenty-hero__thumbnail-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tentwenty-hero__thumbnail::before,
  .tentwenty-hero__thumbnail-progress {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .tentwenty-hero__thumbnail::before {
    content: '';
    border: 1px solid rgb(255 255 255 / 45%);
  }

  .tentwenty-hero__thumbnail-progress {
    inset: 0;
    border: 1px solid #fff;
    clip-path: inset(0 calc(100% - var(--hero-progress, 0%)) 0 0);
  }

  .tentwenty-hero__counter {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0 0.25rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .tentwenty-hero__counter > span:nth-child(2) {
    width: 3.25rem;
    height: 1px;
    background: currentColor;
  }

  .tentwenty-hero[data-enhanced] [data-hero-animate] {
    transform: translateY(1.25rem);
    opacity: 0;
  }

  .tentwenty-hero[data-enhanced] .tentwenty-hero__slide.is-active [data-hero-animate] {
    animation: tentwenty-hero-content-in 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .tentwenty-hero[data-enhanced] .tentwenty-hero__slide.is-active [data-hero-animate]:nth-child(2) {
    animation-delay: 80ms;
  }

  .tentwenty-hero[data-enhanced] .tentwenty-hero__slide.is-active [data-hero-animate]:nth-child(3) {
    animation-delay: 160ms;
  }

  .tentwenty-hero[data-enhanced] .tentwenty-hero__slide.is-active [data-hero-animate]:nth-child(4) {
    animation-delay: 240ms;
  }

  @keyframes tentwenty-hero-content-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .tentwenty-hero {
      min-height: calc(100svh - var(--header-height));
    }

    .tentwenty-hero__image {
      object-position: center;
    }

    .tentwenty-hero__scrim {
      background: linear-gradient(180deg, rgb(0 0 0 / 10%) 0%, rgb(0 0 0 / 40%) 100%);
    }

    .tentwenty-hero__content {
      top: 28%;
      bottom: auto;
      left: var(--page-margin);
    }

    .tentwenty-hero__heading {
      font-size: clamp(2.25rem, 10vw, 3rem);
      max-width: 13ch;
    }

    .tentwenty-hero__controls {
      bottom: 1.5rem;
      left: var(--page-margin);
      gap: 0.25rem;
    }

    .tentwenty-hero__thumbnail {
      width: 2.5rem;
      height: 2.5rem;
    }

    .tentwenty-hero__counter > span:nth-child(2) {
      width: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tentwenty-hero__slide,
    .tentwenty-hero__image {
      transition: none;
    }

    .tentwenty-hero [data-hero-animate],
    .tentwenty-hero[data-enhanced] .tentwenty-hero__slide.is-active [data-hero-animate] {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TenTwenty hero",
  "tag": "section",
  "class": "tentwenty-hero-wrapper",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Slide duration",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessible section label",
      "default": "Featured stories"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "image_picker", "id": "thumbnail_image", "label": "Thumbnail image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome To TenTwenty Farms" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "From Our Farms\\nTo Your Hands" },
        { "type": "richtext", "id": "description", "label": "Description" },
        { "type": "text", "id": "cta_label", "label": "CTA label" },
        { "type": "url", "id": "cta_url", "label": "CTA link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TenTwenty hero",
      "blocks": {
        "slide_1": { "type": "slide" }
      },
      "block_order": ["slide_1"]
    }
  ]
}
{% endschema %}
