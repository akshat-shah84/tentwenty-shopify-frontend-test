{% liquid
  assign duration_ms = section.settings.autoplay_seconds | times: 1000
  assign slide_count = section.blocks.size
  assign first_block = section.blocks.first
%}

<section
  id="tentwenty-hero-{{ section.id }}"
  class="tentwenty-hero-section"
  aria-label="{{ section.settings.accessibility_label | escape }}"
  style="--tentwenty-hero-duration: {{ duration_ms }}ms;"
>
  <tentwenty-hero
    class="tentwenty-hero"
    data-duration="{{ duration_ms }}"
    {% if section.settings.autoplay and slide_count > 1 %}
      data-autoplay
    {% endif %}
  >
    <div class="tentwenty-hero__slides" aria-roledescription="carousel">
      {% for block in section.blocks %}
        {% liquid
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          assign thumbnail_image = block.settings.thumbnail_image | default: desktop_image
          assign image_loading = 'lazy'
          assign image_priority = 'auto'
          if forloop.first
            assign image_loading = 'eager'
            assign image_priority = 'high'
          endif
        %}
        <article
          class="tentwenty-hero__slide{% if forloop.first %} is-active{% endif %}"
          id="tentwenty-hero-slide-{{ section.id }}-{{ forloop.index0 }}"
          data-hero-slide
          data-index="{{ forloop.index0 }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {% unless forloop.first %}inert{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="tentwenty-hero__media">
            {% if desktop_image != blank %}
              <picture>
                {% if mobile_image != blank %}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ mobile_image | image_url: width: 900 }}"
                    width="{{ mobile_image.width }}"
                    height="{{ mobile_image.height }}"
                  >
                {% endif %}
                {{
                  desktop_image
                  | image_url: width: 2880
                  | image_tag:
                    class: 'tentwenty-hero__image',
                    widths: '750, 1100, 1500, 2000, 2400, 2880',
                    sizes: '100vw',
                    loading: image_loading,
                    fetchpriority: image_priority,
                    alt: desktop_image.alt
                }}
              </picture>
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'tentwenty-hero__image tentwenty-hero__image--placeholder' }}
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="tentwenty-hero__scrim" aria-hidden="true"></div>

    {% if first_block != blank %}
      <div class="tentwenty-hero__content">
        {% if first_block.settings.eyebrow != blank %}
          <p class="tentwenty-hero__eyebrow">{{ first_block.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if first_block.settings.heading != blank %}
          <h2 class="tentwenty-hero__heading">{{ first_block.settings.heading | escape | newline_to_br }}</h2>
        {% endif %}
        {% if first_block.settings.description != blank %}
          <div class="tentwenty-hero__description">{{ first_block.settings.description }}</div>
        {% endif %}
        {% if first_block.settings.cta_label != blank and first_block.settings.cta_url != blank %}
          <a class="tentwenty-hero__cta" href="{{ first_block.settings.cta_url }}">
            <span>{{ first_block.settings.cta_label | escape }}</span>
            <span class="svg-wrapper" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if slide_count > 1 %}
      <div class="tentwenty-hero__controls" aria-label="{{ 'accessibility.slideshow' | t }}">
        <div class="tentwenty-hero__thumbnail-viewport">
          <div class="tentwenty-hero__thumbnails" role="tablist" aria-label="Select slide">
            {% for block in section.blocks %}
              {% assign thumbnail_image = block.settings.thumbnail_image | default: block.settings.desktop_image %}
              <button
                class="tentwenty-hero__thumbnail{% if forloop.first %} is-selected{% endif %}"
                type="button"
                role="tab"
                data-hero-thumbnail
                data-index="{{ forloop.index0 }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                aria-controls="tentwenty-hero-slide-{{ section.id }}-{{ forloop.index0 }}"
                aria-label="Slide {{ forloop.index }} of {{ slide_count }}"
              >
                {% if thumbnail_image != blank %}
                  {{ thumbnail_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '44px', alt: thumbnail_image.alt }}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'tentwenty-hero__thumbnail-image' }}
                {% endif %}
                <span class="tentwenty-hero__thumbnail-label" aria-hidden="true">Next</span>
                <span class="tentwenty-hero__thumbnail-progress" aria-hidden="true">
                  <span class="tentwenty-hero__progress-side tentwenty-hero__progress-side--top"></span>
                  <span class="tentwenty-hero__progress-side tentwenty-hero__progress-side--right"></span>
                  <span class="tentwenty-hero__progress-side tentwenty-hero__progress-side--bottom"></span>
                  <span class="tentwenty-hero__progress-side tentwenty-hero__progress-side--left"></span>
                </span>
              </button>
            {% endfor %}
          </div>
        </div>
        <p class="tentwenty-hero__counter" aria-live="polite"><span data-hero-current>01</span><span aria-hidden="true"></span><span>{{ slide_count | prepend: '0' | slice: -2, 2 }}</span></p>
      </div>
    {% endif %}
  </tentwenty-hero>
</section>

<script src="{{ 'tentwenty-hero.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .tentwenty-hero {
    display: block;
    position: relative;
    min-height: clamp(36rem, calc(100svh - var(--header-height, 0px)), 52rem);
    overflow: hidden;
    background: #1d2615;
    color: #fff;
  }

  .tentwenty-hero__slides,
  .tentwenty-hero__slide,
  .tentwenty-hero__media,
  .tentwenty-hero__scrim {
    position: absolute;
    inset: 0;
  }

  .tentwenty-hero__slides {
    z-index: 1;
  }

  .tentwenty-hero__slide {
    opacity: 1;
    pointer-events: none;
    z-index: 0;
    visibility: hidden;
  }

  .tentwenty-hero__slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
    visibility: visible;
  }

  .tentwenty-hero__slide.is-revealing {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
    visibility: visible;
  }

  .tentwenty-hero__media {
    overflow: hidden;
    position: absolute;
    inset: 0;
  }

  .tentwenty-hero__media picture {
    height: 100%;
    
  }

  .tentwenty-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scaleY(0);
    transform-origin: center center;
    will-change: transform;
    backface-visibility: hidden;
  }

  .tentwenty-hero__slide.is-active .tentwenty-hero__image {
    transform: scaleY(1);
    transition: none;
  }

  .tentwenty-hero__slide.is-revealing .tentwenty-hero__image {
    transform: scaleY(1);
    transition: transform 1500ms cubic-bezier(0.25, 1, 0.35, 1);
  }

  .tentwenty-hero__image--placeholder {
    fill: #415530;
  }

  .tentwenty-hero__scrim {
    z-index: 3;
    background: linear-gradient(90deg, rgb(0 0 0 / 35%) 0%, rgb(0 0 0 / 8%) 65%, rgb(0 0 0 / 15%) 100%);
    pointer-events: none;
  }

  .tentwenty-hero__content {
    position: absolute;
    z-index: 5;
    left: max(var(--page-margin), 9vw);
    top: 50%;
    bottom: auto;
    transform: translateY(-50%);
    max-width: min(42rem, calc(100% - var(--page-margin) * 2));
    text-wrap: balance;
    pointer-events: auto;
  }

  .tentwenty-hero__eyebrow,
  .tentwenty-hero__heading,
  .tentwenty-hero__description,
  .tentwenty-hero__cta {
    margin: 0;
    color: inherit;
    text-shadow: 0 1px 12px rgb(0 0 0 / 30%);
  }

  .tentwenty-hero__eyebrow {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .tentwenty-hero__heading {
    max-width: 18ch;
    font-family: var(--font-heading--family);
    font-size: clamp(2.75rem, 4vw, 4.25rem);
    font-weight: var(--font-heading--weight);
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .tentwenty-hero__description {
    max-width: 34rem;
    margin-top: 1.25rem;
    font-size: 1rem;
    line-height: 1.45;
  }

  .tentwenty-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: inherit;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .tentwenty-hero__cta .svg-wrapper,
  .tentwenty-hero__cta svg {
    width: 1rem;
    height: 1rem;
  }

  .tentwenty-hero__controls {
    position: absolute;
    z-index: 4;
    bottom: clamp(1.5rem, 4vw, 3rem);
    left: max(var(--page-margin), 9vw);
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .tentwenty-hero__control,
  .tentwenty-hero__thumbnail {
    appearance: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    background: transparent;
  }

  .tentwenty-hero__control {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    padding: 0;
  }

  .tentwenty-hero__control .svg-wrapper,
  .tentwenty-hero__control svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .tentwenty-hero__previous-icon {
    transform: rotate(180deg);
  }

  .tentwenty-hero__thumbnail-viewport {
    width: 138px;
    height: 138px;
    overflow: hidden;
  }

  .tentwenty-hero__thumbnails {
    display: flex;
    height: 100%;
    transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tentwenty-hero__thumbnail {
    position: relative;
    flex: 0 0 138px;
    width: 138px;
    height: 138px;
    padding: 0.1875rem;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tentwenty-hero__thumbnail img,
  .tentwenty-hero__thumbnail-image {
    display: block;
    width: 93px;
    height: 93px;
    margin: 14px;
    object-fit: cover;
  }

  .tentwenty-hero__thumbnail-progress::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 45%);
    pointer-events: none;
    box-sizing: border-box;
  }

  .tentwenty-hero__thumbnail-progress {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-sizing: border-box;
  }

  .tentwenty-hero__progress-side {
    position: absolute;
    display: block;
    background: #fff;
  }

  .tentwenty-hero__progress-side--top {
    top: 0;
    left: 0;
    width: var(--hero-progress-top, 0%);
    height: 8px;
    transform: translateY(calc(0.5px - 50%));
  }

  .tentwenty-hero__progress-side--right {
    top: 0;
    right: 0;
    width: 8px;
    height: var(--hero-progress-right, 0%);
    transform: translateX(calc(50% - 0.5px));
  }

  .tentwenty-hero__progress-side--bottom {
    bottom: 0;
    right: 0;
    width: var(--hero-progress-bottom, 0%);
    height: 8px;
    transform: translateY(calc(50% - 0.5px));
  }

  .tentwenty-hero__progress-side--left {
    bottom: 0;
    left: 0;
    width: 8px;
    height: var(--hero-progress-left, 0%);
    transform: translateX(calc(0.5px - 50%));
  }

  .tentwenty-hero__thumbnail-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    font-size: 1rem;
    font-weight: 400;
    font-family: var(--font-heading--family);
    pointer-events: none;
    line-height: 1;
    z-index: 2;
  }

  .tentwenty-hero__counter {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0 0.25rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .tentwenty-hero__counter > span:nth-child(2) {
    width: 3.25rem;
    height: 1px;
    background: currentColor;
  }

  @media screen and (max-width: 749px) {
    .tentwenty-hero {
      min-height: 667px;
    }

    .tentwenty-hero__image {
      object-position: center;
    }

    .tentwenty-hero__scrim {
      background: linear-gradient(180deg, rgb(0 0 0 / 10%) 0%, rgb(0 0 0 / 40%) 100%);
    }

    .tentwenty-hero__content {
      left: var(--page-margin);
    }

    .tentwenty-hero__heading {
      font-size: clamp(2.25rem, 10vw, 3rem);
      max-width: 13ch;
    }

    .tentwenty-hero__controls {
      bottom: 1.5rem;
      left: var(--page-margin);
      gap: 0.25rem;
    }

    .tentwenty-hero__thumbnail {
      flex-basis: 115px;
      width: 115px;
      height: 115px;
    }

    .tentwenty-hero__thumbnail-viewport {
      width: 115px;
      height: 115px;
    }

    .tentwenty-hero__counter > span:nth-child(2) {
      width: 2rem;
    }

    .tentwenty-hero__thumbnail-label {
      font-size: 0.875rem;
    }

    .tentwenty-hero__thumbnail img,
    .tentwenty-hero__thumbnail-image {
      width: 77.5px;
      height: 77.5px;
    }

    .tentwenty-hero__counter {
      margin-left: 32px;
    }
  }

  @media screen and (max-width: 575px) {
    .tentwenty-hero {
      min-height: calc(100svh - var(--header-height));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tentwenty-hero__slide,
    .tentwenty-hero__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TenTwenty hero",
  "tag": "section",
  "class": "tentwenty-hero-wrapper",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Slide duration",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessible section label",
      "default": "Featured stories"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "image_picker", "id": "thumbnail_image", "label": "Thumbnail image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome To TenTwenty Farms" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "From Our Farms\\nTo Your Hands" },
        { "type": "richtext", "id": "description", "label": "Description" },
        { "type": "text", "id": "cta_label", "label": "CTA label" },
        { "type": "url", "id": "cta_url", "label": "CTA link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TenTwenty hero",
      "blocks": {
        "slide_1": { "type": "slide" }
      },
      "block_order": ["slide_1"]
    }
  ]
}
{% endschema %}
